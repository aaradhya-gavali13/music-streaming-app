# ==============================================================================
# AuraSound Music Streaming Application - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL or SQLite)
# For production Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/aurasound
# For zero-setup local dev: sqlite+aiosqlite:///./music_stream.db
DATABASE_URL=sqlite+aiosqlite:///./music_stream.db

# JWT Authentication Secret (Generate a secure 32+ character random string)
JWT_SECRET=super-secret-key-production-32-chars-minimum-aurasound-jwt-secret-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Music Provider Selection: "audius" | "jamendo" | "spotify"
# - audius:  1,000,000+ open tracks, official HTTP streaming, zero API keys required (Default)
# - jamendo: 600,000+ Creative Commons tracks, official MP3 stream URLs
# - spotify: 100,000,000+ catalog metadata + official Web Playback SDK adapter
MUSIC_PROVIDER=audius

# Jamendo Provider Configuration (Optional, fallback public key provided)
JAMENDO_CLIENT_ID=56d30c95

# Spotify Provider Configuration (Required only if MUSIC_PROVIDER=spotify)
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSIC_PROVIDER_REDIRECT_URI=http://localhost:5173/callback

# Redis Cache (Optional, in-memory fallback enabled if absent)
REDIS_URL=redis://localhost:6379/0
